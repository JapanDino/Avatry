# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# Optional: comma-separated guild IDs to sync slash commands instantly during development.
# Leave empty to sync globally (can take up to 1 hour to propagate).
DEV_GUILD_IDS=

# SQLite database file (relative to bot/ or absolute path)
DATABASE_PATH=data/bot.db
